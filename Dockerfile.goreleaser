# Dockerfile used by GoReleaser's `dockers_v2` build (issue #104).
#
# Unlike the top-level Dockerfile (which builds from source for `docker build`
# users, issue #149), this one copies the pre-built binary GoReleaser staged
# under $TARGETPLATFORM onto a distroless static, non-root base. It is not
# meant to be built by hand.
FROM gcr.io/distroless/static-debian12:nonroot

LABEL org.opencontainers.image.title="agentfence" \
      org.opencontainers.image.description="Local-first policy firewall for MCP tool calls" \
      org.opencontainers.image.source="https://github.com/dgenio/agentfence" \
      org.opencontainers.image.licenses="Apache-2.0"

ARG TARGETPLATFORM
COPY $TARGETPLATFORM/agentfence /usr/local/bin/agentfence

USER nonroot:nonroot

ENTRYPOINT ["/usr/local/bin/agentfence"]
CMD ["--help"]
